# NetPulse Environment Configuration Example
# Copy this file to .env and configure appropriate values

# Django Settings
DEBUG=True
SECRET_KEY=netpulse-secret-key-change-this-in-production-random-token-xyz789!@#
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=netpulse_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Network Monitoring Engine Settings
DEFAULT_ICMP_INTERVAL_SECONDS=30
DEFAULT_SNMP_TIMEOUT_SECONDS=2
DEFAULT_SNMP_RETRIES=2
